# Relay configuration.
PORT=8787

# The blog origin that issues relay access tokens. The relay calls
#   POST $BLOG_API_URL/api/relay/auth    {username,password}
#   POST $BLOG_API_URL/api/relay/verify  {accessToken}
BLOG_API_URL=https://blog.example.com

# Signs the phone's session cookie. Set it in production so sessions survive restarts.
SESSION_SECRET=replace-with-a-long-random-string

# Cookies get the Secure flag behind TLS.
COOKIE_SECURE=1
SESSION_TTL_MS=604800000

# Where the built @lininn/ds-web versions are unpacked: one directory per version.
WEB_STATIC_DIR=/srv/ds-relay/web-dist

# Optional tuning.
REQUEST_TIMEOUT_MS=120000
PING_MS=15000
PONG_TIMEOUT_MS=45000
BIND_TIMEOUT_MS=30000
